** sch_path: /home/noritsuna/GPS/xschem/tb_lna.sch
**.subckt tb_lna
VDD vdd 0 3.3
XB nb pb vdd 0 bias_gen
VRF s0 0 dc 0 ac 1
RS50 s0 s1 50
CIN s1 rfx 10p
RW rfx rfin 0.001
XP rfin dvdd 0 asigpad
CPM rfin 0 0.2p

.subckt asigpad ASIG DVDD DVSS
D2 DVSS ASIG diode_nd2ps_06v0 m=4 area=150e-12 pj=106e-6
D3 ASIG DVDD diode_pd2nw_06v0 m=4 area=150e-12 pj=106e-6
.ends
VDVDD dvdd 0 3.3
XLNA rfin pb rfp rfn vdd 0 lna_nc
VLI loip 0 2.0
VLIN loin 0 0
VLQ loqp 0 2.0
VLQN loqn 0 0
XM rfp rfn loip loin loqp loqn nb ifip ifin ifqp ifqn vdd 0 mixer_iq
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical

.control
set num_threads=4
op
echo RES op vx=$&v(rfin) idd=$&i(VDD)
ac lin 3 1.561e9 1.589e9
let zin = v(rfx)/(-i(VRF))
let s11 = db((zin-50)/(zin+50))
let gd = db((v(rfp)-v(rfn))/v(s0)*2)
echo RES ac
print frequency real(zin) imag(zin) s11 gd
noise v(rfp,rfn) VRF lin 3 1.561e9 1.589e9
setplot noise1
let nf = 10*log10(inoise_spectrum^2/(4*1.380649e-23*300*50))
print frequency nf
.endc


**** end user architecture code
**.ends

