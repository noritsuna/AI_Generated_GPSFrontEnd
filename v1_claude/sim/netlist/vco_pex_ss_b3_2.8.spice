** sch_path: /home/noritsuna/GPS/xschem/tb_vco.sch
**.subckt tb_vco
VDD vdd 0 3.135
VC vctrl 0 1.5
VB0 b0 0 3.135
VB1 b1 0 3.135
XVCO vctrl b0 b1 l1p l1n l2p l2n l3p l3n l4p l4n ckr vr vdd 0 vco_ring4
CLl1p l1p 0 150f
CLl1n l1n 0 150f
CLl2p l2p 0 150f
CLl2n l2n 0 150f
CLl3p l3p 0 150f
CLl3n l3n 0 150f
CLl4p l4p 0 150f
CLl4n l4n 0 150f
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_ss

.option method=gear reltol=1e-4
.ic v(xvco.xpex.a_31345_57349#)=0 v(xvco.xpex.a_41445_56480#)=2
.option temp=85
.control
set num_threads=1
alter VC dc = 2.8
tran 1p 40n 20n uic
wrdata /home/noritsuna/GPS/sim/pex_vco/pex_ss_b3_2.8.txt v(l1p) v(l1n) v(l2p) v(l2n) v(l3p) v(l3n) v(l4p) v(l4n) i(VDD) v(vr)
.endc

**** end user architecture code
