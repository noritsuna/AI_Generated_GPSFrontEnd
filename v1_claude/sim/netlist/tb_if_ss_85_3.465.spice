** sch_path: /home/noritsuna/GPS/xschem/tb_if.sch
**.subckt tb_if
VDD vdd 0 3.465
.temp 85
XB nb pb vdd 0 bias_gen
VIP inp 0 dc 2.1 ac 0.5
VIN inn 0 dc 2.1 ac 0.5 180
VG1A g1a 0 0
VG1B g1b 0 0
VG2A g2a 0 0
VG2B g2b 0 0
VG3A g3a 0 0
VG3B g3b 0 0
XIF inp inn g1a g1b g2a g2b g3a g3b pb outp outn vdd 0 if_chain
CLP outp 0 100f
CLN outn 0 100f
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_ss

.control
set num_threads=1
op
echo RES op nbif=$&v(xif.nbif) pbif=$&v(xif.pbif) ix=$&v(xif.xbif.x) vdiv=$&v(xif.xbif.vdiv) a1p=$&v(xif.a1p) f1p=$&v(xif.f1p) a2p=$&v(xif.a2p) f2p=$&v(xif.f2p) outp=$&v(outp)
alter VG1A dc = 0
alter VG1B dc = 0
alter VG2A dc = 0
alter VG2B dc = 0
alter VG3A dc = 0
alter VG3B dc = 0
ac dec 40 1e4 1e9
let g = db(v(outp)-v(outn))
meas ac g4 find g at=4.092e6
meas ac g66 find g at=6.6e6
meas ac g112 find g at=11.25e6
meas ac g164 find g at=16.368e6
meas ac gmax max g
let gm3 = gmax - 3
meas ac fl when g=gm3 rise=1
meas ac fh when g=gm3 fall=last
echo RES code=0 g4=$&g4 g6.6=$&g66 g11.25=$&g112 g16.4=$&g164 gmax=$&gmax fl=$&fl fh=$&fh
wrdata if_ac_code0 g
noise v(outp,outn) VIP dec 20 1e5 1e8
setplot noise1
wrdata if_noise_code0 inoise_spectrum onoise_spectrum
alter VG1A dc = 3.3
alter VG1B dc = 0
alter VG2A dc = 3.3
alter VG2B dc = 0
alter VG3A dc = 3.3
alter VG3B dc = 0
ac dec 40 1e4 1e9
let g = db(v(outp)-v(outn))
meas ac g4 find g at=4.092e6
meas ac g66 find g at=6.6e6
meas ac g112 find g at=11.25e6
meas ac g164 find g at=16.368e6
meas ac gmax max g
let gm3 = gmax - 3
meas ac fl when g=gm3 rise=1
meas ac fh when g=gm3 fall=last
echo RES code=1 g4=$&g4 g6.6=$&g66 g11.25=$&g112 g16.4=$&g164 gmax=$&gmax fl=$&fl fh=$&fh
wrdata if_ac_code1 g
noise v(outp,outn) VIP dec 20 1e5 1e8
setplot noise3
wrdata if_noise_code1 inoise_spectrum onoise_spectrum
alter VG1A dc = 0
alter VG1B dc = 3.3
alter VG2A dc = 0
alter VG2B dc = 3.3
alter VG3A dc = 0
alter VG3B dc = 3.3
ac dec 40 1e4 1e9
let g = db(v(outp)-v(outn))
meas ac g4 find g at=4.092e6
meas ac g66 find g at=6.6e6
meas ac g112 find g at=11.25e6
meas ac g164 find g at=16.368e6
meas ac gmax max g
let gm3 = gmax - 3
meas ac fl when g=gm3 rise=1
meas ac fh when g=gm3 fall=last
echo RES code=2 g4=$&g4 g6.6=$&g66 g11.25=$&g112 g16.4=$&g164 gmax=$&gmax fl=$&fl fh=$&fh
wrdata if_ac_code2 g
noise v(outp,outn) VIP dec 20 1e5 1e8
setplot noise5
wrdata if_noise_code2 inoise_spectrum onoise_spectrum
alter VG1A dc = 3.3
alter VG1B dc = 3.3
alter VG2A dc = 3.3
alter VG2B dc = 3.3
alter VG3A dc = 3.3
alter VG3B dc = 3.3
ac dec 40 1e4 1e9
let g = db(v(outp)-v(outn))
meas ac g4 find g at=4.092e6
meas ac g66 find g at=6.6e6
meas ac g112 find g at=11.25e6
meas ac g164 find g at=16.368e6
meas ac gmax max g
let gm3 = gmax - 3
meas ac fl when g=gm3 rise=1
meas ac fh when g=gm3 fall=last
echo RES code=3 g4=$&g4 g6.6=$&g66 g11.25=$&g112 g16.4=$&g164 gmax=$&gmax fl=$&fl fh=$&fh
wrdata if_ac_code3 g
noise v(outp,outn) VIP dec 20 1e5 1e8
setplot noise7
wrdata if_noise_code3 inoise_spectrum onoise_spectrum
.endc

**** end user architecture code
**.ends

