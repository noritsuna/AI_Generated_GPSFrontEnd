** sch_path: /home/noritsuna/GPS/xschem/tb_pll.sch
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.option method=gear reltol=2e-4
.ic v(vctrl)=1.7 v(xpll.xlf.z)=1.7 v(xpll.vcp)=1.7 v(xvco.xcore.p4)=0 v(xvco.xcore.n4)=2
VDD vdd 0 3.3
VDDV vddv 0 3.3
VSUBT sub 0 0
XB nb pb vdd 0 sub bias_gen
VREF refin 0 sin(1.65 0.4 16.368e6)
VB0 b0 0 0
VB1 b1 0 0
XVCO vctrl b0 b1 nb l1p l1n l2p l2n l3p l3n l4p l4n ckr vr vddv 0 sub vco_ring4
VICP2 icp2 0 0
XPLL refin ckr nb pb icp2 vctrl fs fb refck vdd 0 sub pll_core
CLl1p l1p 0 150f
CLl1n l1n 0 150f
CLl2p l2p 0 150f
CLl2n l2n 0 150f
CLl3p l3p 0 150f
CLl3n l3n 0 150f
CLl4p l4p 0 150f
CLl4n l4n 0 150f
CFS fs 0 300f
.option method=gear reltol=2e-4
.ic v(vctrl)=1.56 v(xpll.xlf.z)=1.56 v(xpll.vcp)=1.56 v(xvco.xcore.p4)=0 v(xvco.xcore.n4)=2
.control
set num_threads=1
save v(vctrl) i(VSUBT) i(VDD) i(VDDV)
tran 2p 2.5u 0 2p uic
wrdata /home/noritsuna/GPS/sim/substrate/agg_pll i(VSUBT) v(vctrl) i(VDD) i(VDDV)
.endc
