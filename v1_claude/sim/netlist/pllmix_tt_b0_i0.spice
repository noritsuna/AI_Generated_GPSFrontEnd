**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.option method=gear reltol=2e-4 temp=27
.ic v(vctrl)=2.09 v(xpll.xpex.a_149000_15084#)=2.09 v(xpll.xpex.a_149000_17206.t6)=2.09 v(xvco.xpex.a_43049_28369#)=0 v(xvco.xpex.a_43125_27640#)=2
.control
set num_threads=2
save v(vctrl) v(xpll.xpex.a_149000_17206.t6) v(l1n) v(fb) v(refck) v(fs) v(l1p)
tran 5p 4e-06 0 5p uic
wrdata /home/noritsuna/GPS/sim/pllmix_tt_b0_i0 v(vctrl) v(xpll.xpex.a_149000_17206.t6) v(l1p) v(l1n)
meas tran vc_end avg v(vctrl) from=3.5u to=4u
meas tran vc_pp pp v(vctrl) from=3.5u to=4u
meas tran vc_m avg v(vctrl) from=2.5u to=3u
meas tran vc_e avg v(vctrl) from=3u to=3.5u
meas tran t1 when v(fs)=1.65 rise=40
meas tran t2 when v(fs)=1.65 rise=62
let ffs = 22/(t2-t1)
let flo = ffs*96
meas tran r1 when v(refck)=1.65 rise=62
meas tran b1 when v(fb)=1.65 rise=62
let tpe = b1-r1
echo RES vc_m=$&vc_m vc_e=$&vc_e vc_end=$&vc_end vc_pp=$&vc_pp flo=$&flo phase_err_s=$&tpe
.endc

**** end user architecture code
**.ends

