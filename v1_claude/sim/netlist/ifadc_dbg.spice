**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.option method=gear
.control
set num_threads=1
tran 2n 14u 0 2n
meas tran nb avg v(xif.nbif) from=10u to=14u
meas tran pbv avg v(xif.pbif) from=10u to=14u
meas tran a1 avg v(xif.a1p) from=10u to=14u
meas tran a3 avg v(xif.a3p) from=10u to=14u
meas tran a5 avg v(xif.a5p) from=10u to=14u
meas tran op avg v(aop) from=10u to=14u
meas tran g1 avg v(ig1a) from=10u to=14u
meas tran inr rms v(inp) from=10u to=14u
let vd=v(aop)-v(aon)
let vi=v(inp)-v(inn)
meas tran ord rms vd from=10u to=14u
meas tran ird rms vi from=10u to=14u
meas tran ida avg vi from=10u to=14u
.endc

**** end user architecture code
**.ends

