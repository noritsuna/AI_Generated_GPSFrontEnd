op
alter LP = 1
alter CP = 1e-12
alter LP2 = 1
alter CP2 = 1e-18
alter LSER = 1e-12
alter CSER = 1.8e-12
ac lin 1 1.57542e+09 1.57542e+09
let zin = v(s1)/(-i(VRF))
let s11 = db((zin-50)/(zin+50))
let gd = db((v(rfp)-v(rfn))/v(s0)*2)
let zr = real(zin)
let zi = imag(zin)
noise v(rfp,rfn) VRF lin 1 1.57542e+09 1.57542e+09
setplot noise1
let nf = 10*log10(1+(inoise_spectrum^2-4*1.380649e-23*253.15*50)/(4*1.380649e-23*300*50))
