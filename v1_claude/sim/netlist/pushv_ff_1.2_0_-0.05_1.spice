** sch_path: /home/noritsuna/GPS/xschem/tb_vco.sch
**.subckt tb_vco
VDD vdd 0 3.465
VDDV vddv 0 3.415
VC vctrl 0 1.5
VB0 b0 0 0
VB1 b1 0 0
XB nb pb vdd 0 bias_gen
XBV nbv pbv vddv 0 bias_gen
XVCO vctrl b0 b1 nbv l1p l1n l2p l2n l3p l3n l4p l4n ckr vr vddv 0 vco_ring4
CLl1p l1p 0 150f
CLl1n l1n 0 150f
CLl2p l2p 0 150f
CLl2n l2n 0 150f
CLl3p l3p 0 150f
CLl3n l3n 0 150f
CLl4p l4p 0 150f
CLl4n l4n 0 150f
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice ff
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_ff
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_ff

.option method=gear temp=-20 reltol=1e-4
.ic v(xvco.xcore.p4)=0 v(xvco.xcore.n4)=2
.control
set num_threads=1
let vlist = vector(1)*0+1.2
let k = 0
while k < 1
 let vv = vlist[k]
 alter VC dc = vv
 tran 2p 80n uic
 meas tran ta when v(l1p)=v(l1n) rise=1 td=60n
 meas tran tb when v(l1p)=v(l1n) rise=9 td=60n
 meas tran tq when v(l2p)=v(l2n) rise=1 td=60n
 meas tran ivdd avg i(VDD) from=55n to=70n
 meas tran vravg avg v(vr) from=55n to=70n
 let f = 16/(tb-ta)
 let qerr = ((tq-ta)*f/2 - floor((tq-ta)*f/2))*720 - 90
 echo RES vc=$&vv f=$&f qerr=$&qerr ivdd=$&ivdd vr=$&vravg
 let k = k + 1
end
.endc

**** end user architecture code
**.ends

