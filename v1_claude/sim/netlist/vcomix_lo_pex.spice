** sch_path: /home/noritsuna/GPS/xschem/tb_vco.sch
**.subckt tb_vco
VDD vdd 0 3.3
VC vctrl 0 2.15
VB0 b0 0 0
VB1 b1 0 0
XB nb pb vdd 0 bias_gen
XVCO vctrl b0 b1 l1pv l1nv l2pv l2nv l3pv l3nv l4pv l4nv ckr vr vdd 0 vco_ring4
Rl1p l1pv l1p 9.72
Cl1pa l1pv 0 8.2395e-16
Cl1pb l1p 0 8.2395e-16
Rl1n l1nv l1n 9.12
Cl1na l1nv 0 7.7418e-16
Cl1nb l1n 0 7.7418e-16
Rl2p l2pv l2p 7.32
Cl2pa l2pv 0 6.13255e-16
Cl2pb l2p 0 6.13255e-16
Rl2n l2nv l2n 7.32
Cl2na l2nv 0 6.13255e-16
Cl2nb l2n 0 6.13255e-16
Rl3p l3pv l3p 7.92
Cl3pa l3pv 0 6.64085e-16
Cl3pb l3p 0 6.64085e-16
Rl3n l3nv l3n 8.52
Cl3na l3nv 0 7.2441e-16
Cl3nb l3n 0 7.2441e-16
Rl4p l4pv l4p 8.52
Cl4pa l4pv 0 7.2441e-16
Cl4pb l4p 0 7.2441e-16
Rl4n l4nv l4n 7.92
Cl4na l4nv 0 6.64085e-16
Cl4nb l4n 0 6.64085e-16
VRFP sp 0 sin(0 1m 1.57542e+09 0 0 0)
VRFN sn 0 sin(0 1m 1.57542e+09 0 0 180)
RSP sp rfp_s 50
RSN sn rfn_s 50
CCP rfp_s rfp 10p
CCN rfn_s rfn 10p
XM rfp rfn l1p l1n l2p l2n l3p l3n l4p l4n nb ifip ifin ifqp ifqn vdd 0 mixer_iq
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.option method=gear reltol=1e-4 temp=27
.ic v(xvco.xpex.a_4605_57209#)=0 v(xvco.xpex.a_4605_57209#)=2
.control
set num_threads=2
tran 5p 4e-08 0 5p uic
linearize v(ifip) v(ifin) v(ifqp) v(ifqn) v(l1p) v(l1n) v(l2p) v(l2n) v(l3p) v(l3n) v(l4p) v(l4n)
let vi = v(ifip)-v(ifin)
let vq = v(ifqp)-v(ifqn)
wrdata /home/noritsuna/GPS/sim/pex_vcomix/lo_pex.txt vi vq v(l1p) v(l1n) v(l2p) v(l2n) v(l3p) v(l3n) v(l4p) v(l4n)
.endc
**.ends

