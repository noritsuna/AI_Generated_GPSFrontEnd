** sch_path: /home/noritsuna/GPS/xschem/tb_rx.sch
**.subckt tb_rx
VDD vdd 0 3.3
XB nb pb vdd 0 bias_gen
VL1P l1p 0 dc 1
VL1N l1n 0 dc 1
VL2P l2p 0 dc 1
VL2N l2n 0 dc 1
VL3P l3p 0 dc 1
VL3N l3n 0 dc 1
VL4P l4p 0 dc 1
VL4N l4n 0 dc 1
VRFP rfp 0 dc 1.3 ac 0.5
VRFN rfn 0 dc 1.3 ac -0.5
XM rfp rfn l1p l1n l2p l2n l3p l3n l4p l4n nb ifip ifin ifqp ifqn vdd 0 mixer_iq
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.temp 27
.control
set num_threads=1
alter VL1P dc = 0.864175
alter VL1N dc = 2.72416
alter VL2P dc = 0.864175
alter VL2N dc = 2.72417
alter VL3P dc = 0.267059
alter VL3N dc = 2.12706
alter VL4P dc = 0.267059
alter VL4N dc = 2.12706
op
ac lin 1 1e5 1e5
let gi = real(v(ifip)-v(ifin))
let gq = real(v(ifqp)-v(ifqn))
noise v(ifip,ifin) VRFP lin 2 4.092e+06 5.092e+06 1
setplot noise2
print all
setplot noise1
let ni = onoise_spectrum[0]
echo QS 0 $&ac1.gi $&ac1.gq $&ni
destroy all
