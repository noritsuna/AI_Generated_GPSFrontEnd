** sch_path: /home/noritsuna/GPS/xschem/tb_mixer.sch
**.subckt tb_mixer
VDD vdd 0 3.3
XB nb pb vdd 0 bias_gen
VL1P l1p 0 dc 1.0 ac 0
VL1N l1n 0 dc 1.0 ac 0
VL2P l2p 0 dc 1.0 ac 0
VL2N l2n 0 dc 1.0 ac 0
VL3P l3p 0 dc 1.0 ac 0
VL3N l3n 0 dc 1.0 ac 0
VL4P l4p 0 dc 1.0 ac 0
VL4N l4n 0 dc 1.0 ac 0
VRFP sp 0 sin(0 ARF 1575.42e6 0 0 0)
VRFN sn 0 sin(0 ARF 1575.42e6 0 0 180)
RSP sp rfp_s 50
RSN sn rfn_s 50
CCP rfp_s rfp 10p
CCN rfn_s rfn 10p
XM rfp rfn l1p l1n l2p l2n l3p l3n l4p l4n nb ifip ifin ifqp ifqn vdd 0 mixer_iq
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.param arf=1m
.option method=gear
.control
set num_threads=4
alter @VL1P[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL1P))
alter @VL1P[acmag] = 0
alter @VL1N[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL1N))
alter @VL1N[acmag] = 0
alter @VL2P[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL2P))
alter @VL2P[acmag] = 0
alter @VL2N[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL2N))
alter @VL2N[acmag] = 0
alter @VL3P[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL3P))
alter @VL3P[acmag] = 0
alter @VL3N[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL3N))
alter @VL3N[acmag] = 0
alter @VL4P[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL4P))
alter @VL4P[acmag] = 0
alter @VL4N[acmag] = 1
ac lin 1 7.85664e+08 7.85664e+08
print imag(i(VL4N))
alter @VL4N[acmag] = 0
.endc

**** end user architecture code
**.ends

