** sch_path: /home/noritsuna/GPS/xschem/tb_rx.sch
**.subckt tb_rx
VDD vdd 0 3.3
XB nb pb vdd 0 bias_gen
VL1P l1p 0 pulse(0 2.0 0.000p 60p 60p 576.404p 1272.809p)
VL1N l1n 0 pulse(0 2.0 636.404p 60p 60p 576.404p 1272.809p)
VL2P l2p 0 pulse(0 2.0 159.101p 60p 60p 576.404p 1272.809p)
VL2N l2n 0 pulse(0 2.0 795.505p 60p 60p 576.404p 1272.809p)
VL3P l3p 0 pulse(0 2.0 318.202p 60p 60p 576.404p 1272.809p)
VL3N l3n 0 pulse(0 2.0 954.607p 60p 60p 576.404p 1272.809p)
VL4P l4p 0 pulse(0 2.0 477.303p 60p 60p 576.404p 1272.809p)
VL4N l4n 0 pulse(0 2.0 1113.708p 60p 60p 576.404p 1272.809p)
VRF0 s0 s01 0 sin(0 0.0632456 1.67132767e+09)
VRF1 s01 0 0 sin(0 0.0632456 1.76732767e+09)
RS50 s0 s1 50
CIN s1 rfin 10p
XLNA rfin pb rfp rfn vdd 0 lna_nc
XM rfp rfn l1p l1n l2p l2n l3p l3n l4p l4n nb ifip ifin ifqp ifqn vdd 0 mixer_iq
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical

.option method=gear
.control
set num_threads=1
tran 5p 2.4e-06 0 5p
linearize v(ifip) v(ifin) v(ifqp) v(ifqn) v(rfin) v(rfp) v(rfn)
let vi = v(ifip)-v(ifin)
let vq = v(ifqp)-v(ifqn)
let vr = v(rfp)-v(rfn)
wrdata review/rx_oob_20 vi vq v(rfin) vr
.endc

**** end user architecture code
**.ends

