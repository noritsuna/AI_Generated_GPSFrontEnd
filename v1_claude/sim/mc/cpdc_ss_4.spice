* cp dc
VDD vdd 0 3.135
VG g0 0 0
XB nb pb vdd 0 bias_gen
VO o 0 1.7
VA oa o 0
VB ob o 0
XCPA g0 vdd g0 pb nb g0 oa vdd 0 cp
XCPB g0 vdd g0 pb nb vdd ob vdd 0 cp
VU ou o 0
VD od o 0
XCPU g0 g0 vdd pb nb g0 ou vdd 0 cp
XCPD vdd vdd g0 pb nb g0 od vdd 0 cp
**** begin user architecture code
 .include /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.param sw_stat_mismatch=1
.option seed=4
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_ss
.lib /home/noritsuna/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_ss

.option method=gear reltol=2e-4
.temp 85
.control
set num_threads=1
alter VO dc = 1.2
op
let a = -i(VA)*1e6
let b = -i(VB)*1e6
let u = -i(VU)*1e6
let d = i(VD)*1e6
echo R0 $&a $&b $&u $&d
alter VO dc = 1.5
op
let a = -i(VA)*1e6
let b = -i(VB)*1e6
let u = -i(VU)*1e6
let d = i(VD)*1e6
echo R1 $&a $&b $&u $&d
alter VO dc = 1.7
op
let a = -i(VA)*1e6
let b = -i(VB)*1e6
let u = -i(VU)*1e6
let d = i(VD)*1e6
echo R2 $&a $&b $&u $&d
alter VO dc = 1.9
op
let a = -i(VA)*1e6
let b = -i(VB)*1e6
let u = -i(VU)*1e6
let d = i(VD)*1e6
echo R3 $&a $&b $&u $&d
alter VO dc = 2.2
op
let a = -i(VA)*1e6
let b = -i(VB)*1e6
let u = -i(VU)*1e6
let d = i(VD)*1e6
echo R4 $&a $&b $&u $&d

.endc

**** end user architecture code
**.ends

