XM5 on op x1 VSS nfet_03v3 L=0.28u W=2u nf=1  m=1
XM6 op on x2 VSS nfet_03v3 L=0.28u W=2u nf=1  m=1
XM7 on op VDD VDD pfet_03v3 L=0.28u W=2u nf=1  m=1
XM8 op on VDD VDD pfet_03v3 L=0.28u W=2u nf=1  m=1
XM9 on CLK VDD VDD pfet_03v3 L=0.28u W=1u nf=1  m=1
XM10 op CLK VDD VDD pfet_03v3 L=0.28u W=1u nf=1  m=1
XM11 x1 CLK VDD VDD pfet_03v3 L=0.28u W=1u nf=1  m=1
XM12 x2 CLK VDD VDD pfet_03v3 L=0.28u W=1u nf=1  m=1
XI1 op opb VDD VSS inv_dig
XI2 on onb VDD VSS inv_dig
XS1 opb QB Q VDD VSS nor2
