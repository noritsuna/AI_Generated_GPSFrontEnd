XM2 on_i g2 VSS VSS nfet_03v3 L=0.28u W=40u nf=8  m=8
XR2 on_i VDD VSS ppolyf_u_1k r_width=15u r_length=1u
XMP1 vb1 PB VDD VDD pfet_03v3 L=2u W=32u nf=4  m=6
